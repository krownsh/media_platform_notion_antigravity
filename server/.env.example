# Server Configuration
PORT=3501
FRONTEND_URL=http://localhost:3000

# Supabase Configuration
# The backend requires a server-only elevated key for capture finalization.
# Prefer the modern secret key where the Supabase installation supports it.
SUPABASE_URL=http://your-supabase-url:8000
SUPABASE_SECRET_KEY=replace-with-your-supabase-secret-key
# Legacy compatibility only; use one of these if a secret key is unavailable.
SUPABASE_SERVICE_KEY=replace-with-your-service-role-key

# Capture API authentication for trusted callers such as n8n.
# JWT-authenticated browser requests do not need these settings.
MEDIA_API_KEY=replace-with-a-long-random-secret
MEDIA_API_KEY_USER_ID=replace-with-the-supabase-auth-user-uuid-for-n8n

# Async capture worker (run separately with npm run worker:capture)
CAPTURE_WORKER_ID=media-capture-worker-1
CAPTURE_WORKER_POLL_MS=2000
CAPTURE_IMAGE_BUCKET=collection_capture_uploads
# Legacy LINE/n8n /api/process waits for Capture Worker completion (max 175000).
LEGACY_PROCESS_WAIT_MS=170000

# Hermes Cron Pull. The preprocess Cron atomically claims one workflow and
# releases the lease after persisting the result. Use HERMES_CRON_QUEUE=research
# only for a separate research Cron; review/awaiting_user is never claimed by
# the unattended preprocess run.
HERMES_CRON_AGENT_ID=hermes:cron:media-inbox
HERMES_CRON_LEASE_SECONDS=1800
HERMES_CRON_QUEUE=preprocess

# Hermes local Vault adapter. Leave unset to use the confirmed default:
# ~/.hermes/claude-obsidian. Open that directory once in Obsidian before the
# first note write. /Volumes/DevSSD/claude-obsidian remains the tool checkout.
HERMES_CLAUDE_OBSIDIAN_PATH=

# AI Service Configuration (MiniMax only)
MINIMAX_API_KEY=replace-with-your-minimax-api-key
MINIMAX_GROUP_ID=optional-minimax-group-id

# Apify API Token (Optional - for fallback scraping)
APIFY_API_TOKEN=your_apify_token_here

# Puppeteer Configuration
# For Linux (1Panel ARM/Debian): /usr/bin/chromium
# For Windows: C:\Program Files\Google\Chrome\Application\chrome.exe (or leave empty for default)
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# Social Media Configuration
# Instagram
INSTAGRAM_ACCESS_TOKEN=your-long-lived-page-access-token
INSTAGRAM_ACCOUNT_ID=your-instagram-business-account-id

# Threads
THREADS_ACCESS_TOKEN=your-threads-access-token
THREADS_USER_ID=your-threads-user-id

# Twitter (X)
TWITTER_ACCESS_TOKEN=your-twitter-oauth2-access-token
# Used only by the guest-token crawler; keep it server-side and never log it.
TWITTER_PUBLIC_BEARER_TOKEN=your-x-public-app-bearer-token

# GitHub App (read-only repository synchronization)
# Never put the private key text in this file or commit it. Store the downloaded
# PEM at server/keys/github-app-private-key.pem instead.
GITHUB_APP_ID=your-github-app-id
GITHUB_APP_PRIVATE_KEY_PATH=./keys/github-app-private-key.pem
# Set after installing the App on the GitHub account or organization.
GITHUB_APP_INSTALLATION_ID=your-github-app-installation-id
